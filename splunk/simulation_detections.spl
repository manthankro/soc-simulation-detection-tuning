# Splunk searches for simulation/sample-scenario.jsonl
#
# IMPORT CONTRACT:
# 1. Create an index named soc_simulation.
# 2. Upload the JSONL file as JSON into that index.
# 3. Confirm event_type, simulation, _time, src_ip, dest_ip, dest_port,
#    auth_result, user, exe, path and operation are extracted.
# 4. These searches intentionally filter on event fields, not metadata
#    sourcetype=linux_audit. The uploaded JSON file may have one common
#    Splunk metadata sourcetype for every record.
#
# Run over All time for the bundled fixture (timestamps are 2026-01-15 UTC).

# D01 — More than 25 unique destination ports in a rolling 120-second window.
index=soc_simulation simulation=true event_type=connection_attempt
| where isnotnull(src_ip) AND isnotnull(dest_ip) AND isnotnull(dest_port)
| sort 0 _time
| streamstats time_window=120s dc(dest_port) as unique_ports values(dest_port) as ports by src_ip dest_ip
| where unique_ports > 25
| eval detection_id="D01", severity="LOW", title="High-volume port discovery"
| table _time detection_id severity title src_ip dest_ip unique_ports ports

# D02 — Alert on a successful SSH login only when >10 failures for the same
# source, destination and user occurred during the preceding 300 seconds.
# Sorting by _time and current=f semantics enforce failure-before-success.
index=soc_simulation simulation=true event_type=ssh_auth
| where isnotnull(src_ip) AND isnotnull(dest_ip) AND isnotnull(user)
| sort 0 _time
| streamstats time_window=300s current=f count(eval(auth_result="failure")) as failures_before_success by src_ip dest_ip user
| where auth_result="success" AND failures_before_success > 10
| eval detection_id="D02", severity="HIGH", title="SSH guessing followed by successful authentication"
| table _time detection_id severity title src_ip dest_ip user failures_before_success

# D03 — A web-service identity launches an interactive shell.
# event_type is a JSON event field; no metadata sourcetype assumption is made.
index=soc_simulation simulation=true event_type=process_exec
| where user="www-data" AND (exe="/bin/bash" OR exe="/bin/sh")
| eval detection_id="D03", severity="CRITICAL", title="Web service account launched a shell"
| table _time detection_id severity title host user uid exe parent_exe ppid command_line

# D04 — Cron-file modification indicator.
index=soc_simulation simulation=true event_type=file_change
| where like(path, "%/crontabs/%") AND operation="modified"
| eval detection_id="D04", severity="HIGH", title="Cron schedule modified"
| table _time detection_id severity title host user path operation

# Analyst pivot — all records for the synthetic case.
index=soc_simulation simulation=true scenario_id="SOC-CASE-001"
| sort 0 _time
| table _time phase event_type src_ip dest_ip user auth_result exe parent_exe path operation
